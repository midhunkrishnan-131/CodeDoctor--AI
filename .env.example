# Names only. Put real values in .env (gitignored). Do not commit that file.
# `npm run dev` and `npm start` load this file from the repository root.
# The FastAPI app loads the same file.

# Groq key used when the in-app Settings field is empty.
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=

# Model id used when a diagnose request does not include one.
GROQ_MODEL=

# Gemini key used only when no Groq key is available.
GEMINI_API_KEY=

# Listen port for `npm start` (the Express server).
PORT=

# Set to true to disable Vite hot reload and file watching.
DISABLE_HMR=
