# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this app is hosted (e.g., http://localhost:8000)
APP_URL="http://localhost:8000"

# GROQ_API_KEY: Optional if configured in-app via Settings modal.
# Obtain a free key from https://console.groq.com/keys
GROQ_API_KEY=""

# GROQ_MODEL: Configurable AI model for diagnosis (default: llama-3.3-70b-versatile or qwen/qwen3.8-27b)
GROQ_MODEL="llama-3.3-70b-versatile"

